# 値は書かない。名前だけの見本。実際の値は各自の環境変数（または .env）に設定する。

# 生成方式: vertex | aistudio | dummy（未設定なら自動判定）
GEMINI_BACKEND=
# Vertex AI（クレジット対象）
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Google AI Studio（無料枠）を使う場合のみ
GEMINI_API_KEY=
# 使うモデル（省略可）
GEMINI_MODEL=
# フロントエンドのオリジン（カンマ区切り、省略可）
CORS_ORIGINS=
# 保存先: memory（既定・再起動で消える） / datastore（Firestore Datastoreモード + Cloud Storage）
STORE_BACKEND=
# ファイル置き場（省略時は <プロジェクトID>.appspot.com）
STORAGE_BUCKET=
# ログイン確認: firebase（本番）/ none（既定。固定の開発ユーザーで動く。ローカル・テスト用）
AUTH_BACKEND=
# Firebase のプロジェクトID（省略時は GOOGLE_CLOUD_PROJECT）
FIREBASE_PROJECT_ID=
